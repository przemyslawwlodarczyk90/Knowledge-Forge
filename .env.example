# =====================================================================================
#  Knowledge Forge — konfiguracja środowiska
#  Skopiuj ten plik jako .env (w katalogu projektu) i uzupełnij wartości.
#  .env jest w .gitignore — NIGDY go nie commituj. Zmienna systemowa nadpisuje wartość z .env.
# =====================================================================================

# ╔═══════════════════════════════════════════════════════════════════════════════════╗
# ║  OPENAI — KLUCZ API DO GENEROWANIA NOTATEK (Spring AI)                            ║
# ║  Wklej klucz z https://platform.openai.com/api-keys  (zaczyna się od "sk-...")    ║
# ║  Puste = generowanie notatek przez AI wyłączone (endpoint zwraca 503).            ║
# ╚═══════════════════════════════════════════════════════════════════════════════════╝
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.4
# Dzienny limit generowań notatek na użytkownika (chroni przed kosztami)
AI_DAILY_NOTE_LIMIT=20
# Quiz z AI: ile razy dziennie można dorzucić 100 pytań, maks. rozmiar puli tematu,
# łączny limit czasu (s) na równoległe wywołania modelu przy jednym generowaniu
AI_DAILY_QUIZ_LIMIT=5
AI_QUIZ_MAX_POOL=1000
AI_QUIZ_TIMEOUT_SECONDS=240

# ── Serwer ──────────────────────────────────────────────────────────────────────────
SERVER_PORT=8081
CORS_ALLOWED_ORIGIN=http://localhost:3000
# Adres frontendu — z niego budowany jest link aktywacyjny w mailu (<adres>/confirm?token=...)
FRONTEND_BASE_URL=http://localhost:3000

# ── Baza danych (PostgreSQL) ────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/pgDB
DB_USERNAME=user
DB_PASSWORD=password
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# ── Uwierzytelnianie (JWT) ──────────────────────────────────────────────────────────
# Min. 32 znaki, losowy ciąg (np. openssl rand -base64 48)
JWT_SECRET=
JWT_ISSUER=knowledge-forge
JWT_EXPIRATION_TIME_MS=28800000
# true = logowanie dopiero po kliknięciu linku aktywacyjnego z maila
AUTH_REQUIRE_EMAIL_CONFIRMATION=false
# Konto administratora zakładane przy pierwszym starcie
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@knowledge-forge.local
ADMIN_PASSWORD=
# Jednorazowe przeniesienie danych dawnego wspólnego konta "default" na wskazane konto (puste = nie)
LEGACY_DEFAULT_USERNAME=default
LEGACY_DEFAULT_USER_TRANSFER_TO=

# ── Mail (rejestracja) — puste = link aktywacyjny trafia do logu aplikacji ───────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Pliki na dysku (ścieżki systemowe) ──────────────────────────────────────────────
NOTES_STORAGE_PATH=./data/notes
ATTACHMENTS_STORAGE_PATH=./data/attachments
ATTACHMENTS_MAX_FILE_SIZE_MB=100

# ── Logowanie ───────────────────────────────────────────────────────────────────────
DEBUG_LOGGING=true

# ── Backup bazy (pg_dump -Fc, codziennie o BACKUP_SCHEDULE_HOUR:MINUTE) ─────────────
BACKUP_ENABLED=true
BACKUP_DIRECTORY=./data/database-backups
BACKUP_RETENTION_DAYS=14
BACKUP_SCHEDULE_HOUR=2
BACKUP_SCHEDULE_MINUTE=0
BACKUP_PG_DUMP_PATH=pg_dump
BACKUP_PG_RESTORE_PATH=pg_restore
# Endpoint /api/admin/backups (tylko localhost) — pusty sekret całkowicie go blokuje
BACKUP_RESTORE_ENABLED=false
BACKUP_RESTORE_SECRET=

# ── Weryfikacja aktualności notatek (zob. dokumentacja/ACTUALITY_VERIFICATION.txt) ──
ACTUALITY_VERIFICATION_ENABLED=true
ACTUALITY_VERIFICATION_PERIOD=P2Y
ACTUALITY_VERIFICATION_CRON=0 17 * * 5
ACTUALITY_VERIFICATION_ZONE_ID=Europe/Warsaw

# ── Codzienny zbiorczy backup notatek (.kfbundle) ───────────────────────────────────
NOTE_BUNDLE_BACKUP_ENABLED=true
NOTE_BUNDLE_BACKUP_DIRECTORY=./data/note-bundle-backups
NOTE_BUNDLE_BACKUP_CRON=30 17 * * *
NOTE_BUNDLE_BACKUP_ZONE_ID=Europe/Warsaw

# ── Widoczność elementów UI ─────────────────────────────────────────────────────────
UI_VISIBLE_BINARY_LOADER=false
