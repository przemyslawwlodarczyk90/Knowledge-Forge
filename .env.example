# Zmienne środowiskowe nadpisują config.properties — konwencja:
# "db.url" w pliku właściwości -> "DB_URL" jako zmienna środowiskowa.

# Baza danych
DB_URL=jdbc:postgresql://localhost:5432/pgDB
DB_USERNAME=user
DB_PASSWORD=password

# Serwer / CORS
SERVER_PORT=8081
CORS_ALLOWED_ORIGIN=http://localhost:3000
